{
  "suggest.noselect": true,
  "git.enableGutters": true,
  "git.addGBlameToVirtualText": true,
  "diagnostic.virtualText": true,
  "diagnostic.virtualTextCurrentLineOnly": false,
  "diagnostic.virtualTextPrefix": "■■ ",
  "eslint.experimental.useFlatConfig": true,
  "eslint.rules.customizations": [
    { "rule": "max-lines-per-function", "severity": "off" },
    { "rule": "max-lines", "severity": "off" },
    { "rule": "max-statements", "severity": "off" },
    {
      "rule": "@typescript-eslint/consistent-type-assertions",
      "severity": "off"
    },
    {
      "rule": "@typescript-eslint/no-non-null-assertion",
      "severity": "info"
    }
  ],
  "rust-analyzer.inlayHints.typeHints.enable": true,
  "rust-analyzer.inlayHints.parameterHints.enable": true,
  "rust-analyzer.inlayHints.lifetimeElisionHints.enable": "skip_trivial",
  "rust-analyzer.customTerminal": "FloatermNew --autoclose=0",
  "rust-analyzer.debug.runtime": "nvim-dap",
  "rust-analyzer.debug.nvimdap.configuration.template": "require('plugins/dap').get_configuration_template($exe, $args)",
  "coc.preferences.formatOnSave": true,
  "languageserver": {
    "tsgo": {
      "command": "tsgo",
      "args": ["--lsp", "--stdio"],
      "filetypes": [
        "typescript",
        "typescriptreact",
        "javascript",
        "javascriptreact"
      ],
      "rootPatterns": ["tsconfig.json", "jsconfig.json", ".git/"]
    }
  },
  "tsserver.enable": false,
  "tsserver.maxTsServerMemory": 24000,
  "tsserver.experimental.enableProjectDiagnostics": false,
  "tsserver.useLocalTsdk": true,
  "tsserver.useSyntaxServer": "auto",
  "typescript.format.enable": false,
  "typescript.inlayHints.parameterNames.enabled": "literals",
  "typescript.inlayHints.parameterNames.suppressWhenArgumentMatchesName": true,
  "typescript.inlayHints.parameterTypes.enabled": false,
  "typescript.suggest.enabled": false,
  "clangd.fallbackFlags": ["--std=c++17"],
  "clangd.trace.server": "verbose",
  "eslint.options": {
    "rules": {
      "no-restricted-syntax": "off"
    }
  },
  "json.schemaDownload.trustedDomains": {
    "https://www.schemastore.org": true,
    "https://json.schemastore.org": true
  }
}
