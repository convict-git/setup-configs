# Generates the README's per-intent and host sections from intents/*.zsh, between
# <!-- generated:NAME --> and <!-- /generated:NAME --> markers. What brew
# formulae pull in, cask download hosts and plugin URLs come from
# intents/inventory.txt, which `install.sh --docs --refresh` rebuilds with brew
# and nvim so plain --docs and --docs --check work anywhere.

typeset -gA SOURCE_LABEL=(
  apple "Apple" official "Homebrew installer" brew "Homebrew formula" cask "Homebrew cask"
  git "git clone" npm "npm" nodejs "nvm" rustup "rustup" lazy "lazy.nvim"
  treesitter "nvim-treesitter" coc "coc.nvim" repo "This repo"
)
INVENTORY=$ROOT/intents/inventory.txt

# Rebuilds intents/inventory.txt: brew dependencies, cask download hosts, lazy plugins
docs_refresh_inventory() {
  local id line kind name deps url
  print -r -- "# Generated by install.sh --docs --refresh; read by install.sh --docs." > $INVENTORY
  for id in $INTENT_IDS; do
    for line in ${(f)I_PACKAGES[$id]}; do
      kind=${line%% *} name=${${line#* }%% *}
      case $kind in
        brew)
          deps=(${(f)"$(HOMEBREW_NO_AUTO_UPDATE=1 brew deps --formula $name 2>/dev/null)"})
          print -r -- "brew-deps $name ${(j: :)deps}" >> $INVENTORY ;;
        cask)
          url=$(HOMEBREW_NO_AUTO_UPDATE=1 brew info --json=v2 --cask $name 2>/dev/null |
            plutil -extract casks.0.url raw -o - - 2>/dev/null)
          url=${${url#*://}%%/*}
          print -r -- "cask-host $name $url" >> $INVENTORY ;;
      esac
    done
  done
  nvim --headless -c 'lua
    local C = require("lazy.core.config")
    local seen, out = {}, {}
    local function add(p, conditional)
      if seen[p.name] then return end
      seen[p.name] = true
      local url = (p.url or ""):gsub("^https://github.com/", ""):gsub("%.git$", "")
      table.insert(out, "lazy " .. url .. (conditional and " optional" or ""))
    end
    for _, p in pairs(C.plugins) do add(p, p.enabled ~= nil) end
    for _, p in pairs(C.spec.disabled) do add(p, true) end
    table.sort(out)
    io.stdout:write(table.concat(out, "\n") .. "\n")' -c qa 2>/dev/null >> $INVENTORY
}

# inventory_get <kind> <name>: the rest of that line
inventory_get() {
  [[ -f $INVENTORY ]] || return 0
  awk -v k=$1 -v n=$2 '$1 == k && $2 == n { $1 = ""; $2 = ""; sub(/^  /, ""); print; exit }' $INVENTORY
}

docs_md_escape() { print -r -- "${${1//|/\\|}//</&lt;}" }

docs_intents() {
  local id line kind rest dep meta deps lazy_lines
  local -a formulae
  for id in $INTENT_IDS; do
    print -r -- "### ${I_TITLE[$id]}"
    print
    print -r -- "${I_WHY[$id]}"
    print
    meta=()
    (( I_ALWAYS[$id] )) && meta+="**Always included**"
    [[ -n ${I_REQUIRES[$id]} ]] && meta+="**Needs:** ${(j:, :)${(@)${=I_REQUIRES[$id]}/(#m)*/${I_TITLE[$MATCH]}}}"
    [[ -n ${I_SOFT[$id]} ]] && meta+="**Works best with:** ${(j:, :)${(@)${=I_SOFT[$id]}/(#m)*/${I_TITLE[$MATCH]}}}"
    (( $#meta )) && { print -r -- "${(j: · :)meta}"; print }
    if [[ -n ${I_SUDO[$id]} ]]; then
      print -r -- "**Uses sudo** (each step asks first):"
      for line in ${(f)I_SUDO[$id]}; do print -r -- "- $line"; done
      print
    fi
    print -r -- "| Source | What |"
    print -r -- "|---|---|"
    formulae=()
    for line in ${(f)I_PACKAGES[$id]}; do
      kind=${line%% *} rest=${line#* }
      [[ $kind == brew ]] && formulae+=${rest%% *}
      print -r -- "| ${SOURCE_LABEL[$kind]:-$kind} | $(docs_md_escape $rest) |"
    done
    print
    if [[ -n ${I_HOSTS[$id]} ]]; then
      print -r -- "Downloads from: ${(j:, :)${(@)${=I_HOSTS[$id]}/(#m)*/\`$MATCH\`}}"
      print
    fi
    deps=()
    for line in $formulae; do
      rest=$(inventory_get brew-deps $line)
      [[ -n $rest ]] && deps+="- **$line** → ${(j:, :)${=rest}}"
    done
    if (( $#deps )); then
      print -r -- "<details><summary>What these Homebrew formulae pull in</summary>"
      print
      print -l -- $deps
      print
      print -r -- "</details>"
      print
    fi
    if [[ $id == neovim && -f $INVENTORY ]]; then
      lazy_lines=(${(f)"$(awk '$1 == "lazy" { print "`" $2 "`" ($3 == "optional" ? " (only with its intent'"'"'s tool)" : "") }' $INVENTORY)"})
      print -r -- "<details><summary>The ${#lazy_lines} lazy.nvim plugins (git clones from github.com)</summary>"
      print
      print -r -- "${(j: · :)lazy_lines}"
      print
      print -r -- "</details>"
      print
    fi
  done
}

docs_hosts() {
  local id host line name
  local -A used_by
  for id in $INTENT_IDS; do
    for host in ${=I_HOSTS[$id]}; do used_by[$host]+="${used_by[$host]:+, }${I_TITLE[$id]}"; done
    for line in ${(f)I_PACKAGES[$id]}; do
      [[ ${line%% *} == cask ]] || continue
      name=${${line#cask }%% *}
      host=$(inventory_get cask-host $name)
      [[ -n $host && ${used_by[$host]} != *${I_TITLE[$id]}* ]] && used_by[$host]+="${used_by[$host]:+, }${I_TITLE[$id]}"
    done
  done
  print -r -- "| Host | Used by |"
  print -r -- "|---|---|"
  for host in ${(ok)used_by}; do print -r -- "| \`$host\` | ${used_by[$host]} |"; done
}

# docs_replace <readme text> <section name> <content>: prints the new readme
docs_replace() {
  local text=$1 name=$2 content=$3
  local begin="<!-- generated:$name -->" end="<!-- /generated:$name -->"
  if [[ $text != *$begin*$end* ]]; then
    print -u2 "README.md has no $begin ... $end markers"
    return 1
  fi
  print -r -- "${text%%$begin*}$begin"$'\n'"$content"$'\n'"$end${text#*$end}"
}

docs_main() {
  local mode=$1 readme=$ROOT/README.md text new
  if [[ $mode == refresh ]]; then
    docs_refresh_inventory
    print "Refreshed $(tildify $INVENTORY)"
  fi
  text=$(<$readme)
  new=$(docs_replace "$text" intents "$(docs_intents)") || return 1
  new=$(docs_replace "$new" hosts "$(docs_hosts)") || return 1
  if [[ $mode == check ]]; then
    if [[ $new != $text ]]; then
      print -u2 "README.md is out of date: run ./install.sh --docs"
      return 1
    fi
    print "README.md is up to date"
    return 0
  fi
  print -r -- $new > $readme
  print "Updated README.md"
}
